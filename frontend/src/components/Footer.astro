---
interface Props {
  game?: 'cs2' | 'valorant';
}

const { game = 'cs2' } = Astro.props;

const socials = [
  { label: 'Steam', href: 'https://steamcommunity.com/id/pmec', icon: '🎮' },
  { label: 'FACEIT', href: 'https://www.faceit.com/en/players/pmec', icon: '🎯' },
  { label: 'Twitch', href: 'https://www.twitch.tv/pmec', icon: '📺' },
  { label: 'Twitter', href: 'https://twitter.com/pmec', icon: '🐦' },
  { label: 'Settings', href: 'https://settings.gg/pmec/cs2', icon: '⚙️' },
];

const tagline =
  game === 'valorant'
    ? 'Valorant performance & agent stats for pmec'
    : 'CS2 stats & progress tracker for pmec';
---

<footer class="mt-auto border-t border-game bg-game-secondary/80 md:pl-[4.25rem]">
  <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-6 px-5 py-10 md:flex-row md:px-8">
    <div class="text-center md:text-left">
      <span class="font-display text-lg font-semibold text-game-primary">Statsmec</span>
      <p class="mt-1 text-sm text-game-muted">{tagline}</p>
    </div>
    <div class="flex gap-3">
      {socials.map((s) => (
        <a
          href={s.href}
          target="_blank"
          rel="noreferrer"
          title={s.label}
          class="flex h-10 w-10 items-center justify-center rounded-full border border-game bg-game-card text-base transition-all hover:-translate-y-0.5 hover:border-[var(--accent)]/40 hover:shadow-md"
        >
          {s.icon}
        </a>
      ))}
    </div>
    <p class="text-center text-xs text-game-muted md:text-right">
      &copy; {new Date().getFullYear()} pmec. Built with Astro + Svelte.
    </p>
  </div>
</footer>
