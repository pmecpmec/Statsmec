# Frontend environment variables
# PUBLIC_ prefix required for Astro to expose vars to the client-side bundle
# Copy this file to .env and fill in your values for local development.

# URL of the backend API (must be reachable from the browser, not just the server)
PUBLIC_API_URL=http://localhost:8000/api/v1

# For production (GitHub Pages), set this as a GitHub Actions repository variable:
#   Settings → Secrets and variables → Actions → Variables → New repository variable
#   Name: PUBLIC_API_URL
#   Value: https://your-backend-domain.com/api/v1
